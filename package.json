{
  "name": "ai-usage-meter",
  "version": "1.0.0",
  "description": "Local browser dashboard for Claude Code and Codex usage, covering every ccusage report",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "ccusage",
    "usage",
    "tokens",
    "cost",
    "dashboard"
  ],
  "license": "MIT",
  "author": "Shiro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thprinkleth/ai-usage-meter.git"
  },
  "homepage": "https://github.com/thprinkleth/ai-usage-meter#readme",
  "type": "module",
  "main": "server.js",
  "bin": {
    "ai-usage-meter": "bin/ai-usage-meter.js"
  },
  "files": [
    "server.js",
    "bin",
    "public"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node server.js --open",
